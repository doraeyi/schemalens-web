{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run DBSchema Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/apps/vscode-extension"],
      "outFiles": ["${workspaceFolder}/apps/vscode-extension/out/**/*.cjs"],
      "preLaunchTask": "npm: build - dbschema-vscode"
    }
  ]
}
