# Copy this file to .env for local development, or set these as Environment
# Variables in the Vercel project settings for production/preview deploys.
# Never commit the real .env file — it's already in .gitignore.

# Auth.js session signing secret. Generate one with: openssl rand -hex 32
AUTH_SECRET=

# GitHub OAuth App credentials (GitHub → Settings → Developer settings → OAuth Apps).
# Authorization callback URL must be: https://<your-domain>/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# MySQL connection string, e.g. mysql://user:password@host:3306/database
DATABASE_URL=
