{
  "name": "dbschema-vscode",
  "displayName": "DBSchema",
  "description": "Database Schema Visualization for VS Code",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Visualization", "Programming Languages"],
  "main": "./out/extension.cjs",
  "contributes": {
    "languages": [
      {
        "id": "dbschema",
        "aliases": ["DBSchema", "dbschema"],
        "extensions": [".dbschema"],
        "configuration": "./language/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dbschema",
        "scopeName": "source.dbschema",
        "path": "./language/dbschema.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "dbschema.openPreview",
        "title": "DBSchema: Open Preview",
        "icon": "$(graph)"
      },
      {
        "command": "dbschema.validateSchema",
        "title": "DBSchema: Validate Schema"
      },
      {
        "command": "dbschema.fitView",
        "title": "DBSchema: Fit View"
      },
      {
        "command": "dbschema.resetFocus",
        "title": "DBSchema: Reset Focus"
      },
      {
        "command": "dbschema.openSpikePreview",
        "title": "DBSchema: Open Spike Preview (Synthetic Schema)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "dbschema.openPreview",
          "when": "resourceLangId == dbschema",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch"
  },
  "dependencies": {
    "@schemalens/schema-core": "*",
    "@schemalens/schema-fixtures": "*",
    "@schemalens/schema-graph": "*",
    "@schemalens/schema-layout": "*",
    "@schemalens/schema-parser": "*",
    "@schemalens/schema-renderer": "*"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0"
  }
}
